[Unit]
Description=Lolweapon Nginx observability summary
Documentation=file:///home/kalaplex/resubidos-qa/docs/operations/nginx-observability.md
After=nginx.service

[Service]
Type=oneshot
User=kalaplex
Group=kalaplex
SupplementaryGroups=adm
WorkingDirectory=/home/kalaplex/resubidos-qa
ExecStart=/usr/bin/env node scripts/summarize-nginx-observability.mjs --minutes 15
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict

SyslogIdentifier=lolweapon-nginx-metrics
StandardOutput=journal
StandardError=journal

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Anime {
  id                 Int                       @id @default(autoincrement())
  key                String                    @unique
  title              String
  titleEs            String?
  image              String?
  description        String?
  descriptionEs      String?
  year               Int?
  episodes           Int?
  formatId           Int?
  releaseStatusId    Int?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  format             AnimeFormat?              @relation(fields: [formatId], references: [id])
  releaseStatus      AnimeReleaseStatus?       @relation(fields: [releaseStatusId], references: [id])
  libraryEntry       AnimeLibraryEntry?
  externalReferences AnimeExternalReference[]
  userActivity       PlatformUserAnime[]
  ratings            AnimeRating[]

  @@index([formatId])
  @@index([releaseStatusId])
  @@index([year])
}

model AnimeLibraryEntry {
  id                Int               @id @default(autoincrement())
  animeId           Int               @unique
  watchStatusId     Int
  trackerTagId      Int?
  currentEpisode    Int?
  purchasedEpisodes Int?
  isFullSeason      Boolean           @default(false)
  libraryEnabled    Boolean           @default(true)
  trackerUrl        String?
  deletedAt         DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  anime             Anime             @relation(fields: [animeId], references: [id], onDelete: Cascade)
  watchStatus       AnimeWatchStatus  @relation(fields: [watchStatusId], references: [id])
  trackerTag        Tag?              @relation("AnimeLibraryTrackerTag", fields: [trackerTagId], references: [id])

  @@index([watchStatusId])
  @@index([trackerTagId])
  @@index([libraryEnabled])
  @@index([isFullSeason])
  @@index([deletedAt])
}

model AnimeExternalReference {
  id              Int              @id @default(autoincrement())
  animeId         Int
  providerId      Int
  providerMediaId Int?
  url             String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  anime           Anime            @relation(fields: [animeId], references: [id], onDelete: Cascade)
  provider        ExternalProvider @relation(fields: [providerId], references: [id])

  @@unique([animeId, providerId])
  @@unique([providerId, providerMediaId])
  @@index([animeId])
  @@index([providerId])
}

model ExternalProvider {
  id         Int                       @id @default(autoincrement())
  code       String                    @unique
  name       String
  baseUrl    String?
  isActive   Boolean                   @default(true)
  sortOrder  Int                       @default(0)

  references AnimeExternalReference[]
}

model AnimeFormat {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  label     String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)

  animes    Anime[]
}

model AnimeReleaseStatus {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  label     String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)

  animes    Anime[]
}

model AnimeWatchStatus {
  id             Int                 @id @default(autoincrement())
  code           String              @unique
  label          String
  isActive       Boolean             @default(true)
  sortOrder      Int                 @default(0)

  libraryEntries AnimeLibraryEntry[]
}

model TagCategory {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  label     String
  icon      String?
  exact     String[] @default([])
  keywords  String[] @default([])
  isCustom  Boolean  @default(false)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)

  tags      Tag[]
}

model Tag {
  id                    Int                 @id @default(autoincrement())
  name                  String
  slug                  String              @unique
  categoryId            Int?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  category              TagCategory?        @relation(fields: [categoryId], references: [id])
  animeLibraryEntries   AnimeLibraryEntry[] @relation("AnimeLibraryTrackerTag")
  lives                 LiveTag[]

  @@index([categoryId])
}

model Live {
  id             Int        @id @default(autoincrement())
  legacyId       String     @unique
  title          String
  date           DateTime?
  year           Int?
  statusId       Int?
  image          String?
  additionalInfo String?
  notifiedAt     DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  status         LiveStatus? @relation(fields: [statusId], references: [id])
  tags           LiveTag[]
  links          LiveLink[]
  userActivity   PlatformUserLive[]
  audienceSessions StreamAudienceSession[]

  @@index([statusId])
  @@index([year])
  @@index([date])
  @@index([notifiedAt])
}

model StreamAudienceSession {
  id                    Int                    @id @default(autoincrement())
  liveId                Int?
  twitchStreamId        String                 @unique
  twitchLogin           String
  title                 String
  categoryName          String?
  startedAt             DateTime
  endedAt               DateTime?
  peakConcurrent        Int                    @default(0)
  averageConcurrent     Float                  @default(0)
  lastConcurrent        Int                    @default(0)
  peakTwitchConcurrent  Int?
  averageTwitchConcurrent Float?
  audienceMinutes       Int                    @default(0)
  sampleCount           Int                    @default(0)
  lastSampleAt          DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  live                  Live?                  @relation(fields: [liveId], references: [id], onDelete: SetNull)
  samples               StreamAudienceSample[]

  @@index([liveId])
  @@index([startedAt])
  @@index([endedAt])
}

model StreamAudienceSample {
  id                    Int                   @id @default(autoincrement())
  sessionId             Int
  capturedAt            DateTime
  concurrentCount       Int
  twitchConcurrentCount Int?
  createdAt             DateTime              @default(now())

  session               StreamAudienceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, capturedAt])
  @@index([capturedAt])
}

model LiveStatus {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  label     String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)

  lives     Live[]
}

model LiveTag {
  liveId   Int
  tagId    Int
  position Int @default(0)

  live     Live @relation(fields: [liveId], references: [id], onDelete: Cascade)
  tag      Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([liveId, tagId])
  @@index([tagId])
}

model LiveLink {
  id         Int          @id @default(autoincrement())
  liveId     Int
  platformId Int
  url        String
  label      String?
  position   Int          @default(0)

  live       Live         @relation(fields: [liveId], references: [id], onDelete: Cascade)
  platform   LinkPlatform @relation(fields: [platformId], references: [id])

  @@index([liveId])
  @@index([platformId])
}

model LinkPlatform {
  id        Int        @id @default(autoincrement())
  code      String     @unique
  label     String
  isActive  Boolean    @default(true)
  sortOrder Int        @default(0)

  links     LiveLink[]
}

model YoutubeVideo {
  id          String   @id
  title       String
  publishedAt DateTime?
  thumbnail   String?
  url         String
  notifiedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([publishedAt])
  @@index([createdAt])
  @@index([notifiedAt])
}

model SpaceDrum {
  id          Int                 @id @default(autoincrement())
  key         String              @unique
  title       String
  subtitle    String?
  status      String?
  coverImage  String?
  heroImage   String?
  description String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  meta        SpaceDrumMeta[]
  links       SpaceDrumLink[]
  chapters    SpaceDrumChapter[]
}

model SpaceDrumMeta {
  id          Int       @id @default(autoincrement())
  spaceDrumId Int
  label       String
  value       String
  position    Int       @default(0)

  spaceDrum   SpaceDrum @relation(fields: [spaceDrumId], references: [id], onDelete: Cascade)

  @@index([spaceDrumId])
}

model SpaceDrumLink {
  id          Int       @id @default(autoincrement())
  spaceDrumId Int
  label       String
  url         String
  position    Int       @default(0)

  spaceDrum   SpaceDrum @relation(fields: [spaceDrumId], references: [id], onDelete: Cascade)

  @@index([spaceDrumId])
}

model SpaceDrumChapter {
  id          Int              @id @default(autoincrement())
  spaceDrumId Int
  legacyId    String
  title       String
  releaseDate String?
  summary     String?
  status      String           @default("published")
  position    Int              @default(0)

  spaceDrum   SpaceDrum        @relation(fields: [spaceDrumId], references: [id], onDelete: Cascade)
  pages       SpaceDrumPage[]

  @@unique([spaceDrumId, legacyId])
  @@index([spaceDrumId])
}

model SpaceDrumPage {
  id        Int              @id @default(autoincrement())
  chapterId Int
  image     String
  alt       String?
  position  Int              @default(0)

  chapter   SpaceDrumChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([chapterId])
}

model PlatformUserSpaceDrumProgress {
  id             Int          @id @default(autoincrement())
  userId         Int
  language       String
  lastChapterId  String?
  readChapterIds String[]     @default([])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user           PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, language])
  @@index([userId])
  @@index([language])
}

model PlatformRole {
  id          Int            @id @default(autoincrement())
  code        String         @unique
  label       String
  sortOrder   Int            @default(0)
  isActive    Boolean        @default(true)
  canAdmin    Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  users       PlatformUser[]
  permissions PlatformRolePermission[]

  @@index([isActive])
  @@index([canAdmin])
  @@index([sortOrder])
}

model PlatformPermission {
  id          Int                      @id @default(autoincrement())
  code        String                   @unique
  label       String
  group       String
  description String?
  sortOrder   Int                      @default(0)
  isActive    Boolean                  @default(true)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  roles       PlatformRolePermission[]

  @@index([group])
  @@index([isActive])
  @@index([sortOrder])
}

model PlatformRolePermission {
  roleId       Int
  permissionId Int
  assignedAt   DateTime           @default(now())

  role         PlatformRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   PlatformPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model PlatformUser {
  id             Int               @id @default(autoincrement())
  twitchUserId   String?           @unique
  login          String            @unique
  alias          String
  email          String            @unique
  avatarUrl      String?
  twitchSubscriberTier String?
  isTwitchModerator Boolean        @default(false)
  isTwitchVip    Boolean           @default(false)
  twitchRoleSyncedAt DateTime?
  passwordHash   String?
  passwordSalt   String?
  passwordUpdatedAt DateTime?
  roleId         Int
  roleSource     String            @default("manual")
  isActive       Boolean           @default(true)
  deletedAt      DateTime?
  lastLoginAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  role           PlatformRole      @relation(fields: [roleId], references: [id])
  sessions       PlatformSession[]
  liveActivity   PlatformUserLive[]
  animeActivity  PlatformUserAnime[]
  animeRatings   AnimeRating[]
  spaceDrumProgress PlatformUserSpaceDrumProgress[]
  createdNotifications PlatformNotification[] @relation("NotificationCreator")
  notificationStates PlatformUserNotification[]
  supportTickets SupportTicket[]
  supportTicketMessages SupportTicketMessage[]
  authIdentities PlatformAuthIdentity[]
  identityLinkAttempts PlatformIdentityLinkAttempt[]
  seasonalAnimeFavorites PlatformUserSeasonalAnimeFavorite[]
  animeTierLists PlatformUserAnimeTierList[]

  @@index([roleId])
  @@index([isActive])
  @@index([deletedAt])
}


model PlatformAuthIdentity {
  id              Int      @id @default(autoincrement())
  userId          Int
  provider        String
  providerSubject String
  providerEmail   String?
  emailVerified   Boolean  @default(false)
  providerLogin   String?
  displayName     String?
  avatarUrl       String?
  metadata        Json?
  linkedAt        DateTime @default(now())
  lastUsedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@unique([userId, provider])
  @@index([userId])
  @@index([providerEmail])
}

model PlatformIdentityLinkAttempt {
  id              String    @id
  userId          Int?
  provider        String
  providerSubject String
  providerEmail   String?
  emailVerified   Boolean   @default(false)
  providerLogin   String?
  displayName     String?
  avatarUrl       String?
  metadata        Json?
  expiresAt       DateTime
  consumedAt      DateTime?
  createdAt       DateTime  @default(now())

  user PlatformUser? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([provider, providerSubject])
}

model PlatformUserLive {
  id        Int          @id @default(autoincrement())
  userId    Int
  liveId    Int
  isSaved   Boolean      @default(false)
  isWatched Boolean      @default(false)
  savedAt   DateTime?
  watchedAt DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user      PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  live      Live         @relation(fields: [liveId], references: [id], onDelete: Cascade)

  @@unique([userId, liveId])
  @@index([userId])
  @@index([liveId])
  @@index([isSaved])
  @@index([isWatched])
}

model PlatformUserAnime {
  id              Int          @id @default(autoincrement())
  userId          Int
  animeId         Int
  isFavorite      Boolean      @default(false)
  listStatus      String?
  isHidden        Boolean      @default(false)
  favoritedAt     DateTime?
  statusUpdatedAt DateTime?
  hiddenAt        DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user            PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  anime           Anime        @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@unique([userId, animeId])
  @@index([userId])
  @@index([animeId])
  @@index([isFavorite])
  @@index([listStatus])
  @@index([isHidden])
}

model PlatformSession {
  id        Int          @id @default(autoincrement())
  token     String       @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime     @default(now())

  user      PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model LoginAttempt {
  id        Int      @id @default(autoincrement())
  login     String?
  ip        String?
  userAgent String?
  success   Boolean  @default(false)
  reason    String?
  createdAt DateTime @default(now())

  @@index([login])
  @@index([ip])
  @@index([success])
  @@index([createdAt])
}

model PlatformNotification {
  id              Int                        @id @default(autoincrement())
  type            String
  severity        String                     @default("info")
  source          String                     @default("system")
  title           String
  body            String?
  href            String?
  icon            String?
  metadata        Json?
  dedupeKey       String?                    @unique
  audience        String                     @default("authenticated")
  isActive        Boolean                    @default(true)
  createdByUserId Int?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  scheduledAt     DateTime?
  publishedAt     DateTime?
  expiresAt       DateTime?
  deletedAt       DateTime?

  createdBy       PlatformUser?              @relation("NotificationCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  userStates      PlatformUserNotification[]

  @@index([type])
  @@index([severity])
  @@index([source])
  @@index([audience])
  @@index([isActive])
  @@index([dedupeKey])
  @@index([createdByUserId])
  @@index([createdAt])
  @@index([scheduledAt])
  @@index([publishedAt])
  @@index([expiresAt])
  @@index([deletedAt])
}

model PlatformUserNotification {
  id             Int                  @id @default(autoincrement())
  userId         Int
  notificationId Int
  readAt         DateTime?
  dismissedAt    DateTime?
  createdAt      DateTime             @default(now())

  user           PlatformUser         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification   PlatformNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationId])
  @@index([userId])
  @@index([notificationId])
  @@index([readAt])
  @@index([dismissedAt])
}

model SupportTicket {
  id              Int                    @id @default(autoincrement())
  createdByUserId Int
  type            String
  subject         String
  status          String                 @default("open")
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  lastMessageAt   DateTime               @default(now())
  closedAt        DateTime?

  createdBy       PlatformUser           @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  messages        SupportTicketMessage[]

  @@index([createdByUserId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@index([lastMessageAt])
}

model SupportTicketMessage {
  id        Int           @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  body      String
  isAdmin   Boolean       @default(false)
  createdAt DateTime      @default(now())

  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author    PlatformUser  @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([authorId])
  @@index([isAdmin])
  @@index([createdAt])
}

model AnimeRating {
  id        Int          @id @default(autoincrement())
  userId    Int
  animeId   Int
  scoreTenths Int
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user      PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  anime     Anime        @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@unique([userId, animeId])
  @@index([userId])
  @@index([animeId])
}

model AnimeSeason {
  id             Int               @id @default(autoincrement())
  year           Int
  season         String
  status         String            @default("draft")
  lastSyncedAt   DateTime?
  lastSyncStatus String?
  createdSource  String            @default("calendar")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  animes         SeasonalAnime[]
  syncs          SeasonalAnimeSync[]
  tierListEntries AnimeTierListEntry[]
  tierLists      PlatformUserAnimeTierList[]

  @@unique([year, season])
  @@index([status])
  @@index([year, season])
}

model SeasonalAnime {
  id                    Int                    @id @default(autoincrement())
  seasonId              Int
  aniListId             Int
  animeScheduleRoute    String?
  titleRomaji           String
  titleEnglish          String?
  titleNative           String?
  description           String?
  imageUrl              String?
  format                String?
  episodes              Int?
  status                String?
  aniListUrl            String?
  trailerSite           String?
  trailerId             String?
  tags                  Json?
  isAdult               Boolean                @default(false)
  isDonghua             Boolean                @default(false)
  sourceVisible         Boolean                @default(true)
  manualTitle           String?
  manualVisible         Boolean?
  sourceUpdatedAt       DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  season                AnimeSeason            @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  airings               SeasonalAnimeAiring[]

  @@unique([seasonId, aniListId])
  @@index([seasonId])
  @@index([aniListId])
  @@index([isAdult])
  @@index([isDonghua])
}

model SeasonalAnimeAiring {
  id                    Int             @id @default(autoincrement())
  seasonalAnimeId       Int
  sourceKey             String
  episode               Int
  sourceAiringAt        DateTime
  sourceStatus          String          @default("scheduled")
  sourcePlatforms       Json?
  manualAiringAt        DateTime?
  manualEpisode         Int?
  manualStatus          String?
  manualPlatform        String?
  manualStreamingUrl    String?
  manualVisible         Boolean?
  sourceUpdatedAt       DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  anime                 SeasonalAnime   @relation(fields: [seasonalAnimeId], references: [id], onDelete: Cascade)

  @@unique([seasonalAnimeId, sourceKey])
  @@index([seasonalAnimeId])
  @@index([sourceAiringAt])
  @@index([sourceStatus])
}

model SeasonalAnimeSync {
  id             Int         @id @default(autoincrement())
  seasonId       Int
  status         String
  source         String      @default("animeschedule+anilist")
  startedAt      DateTime    @default(now())
  completedAt    DateTime?
  summary        Json?
  errorMessage   String?

  season         AnimeSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@index([seasonId])
  @@index([status])
  @@index([startedAt])
}

model PlatformUserSeasonalAnimeFavorite {
  id        Int          @id @default(autoincrement())
  userId    Int
  aniListId Int
  createdAt DateTime     @default(now())

  user      PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, aniListId])
  @@index([userId])
}

model AnimeTierListEntry {
  id              Int         @id @default(autoincrement())
  seasonId        Int
  aniListId       Int?
  isManual        Boolean     @default(false)
  titleRomaji     String
  titleEnglish    String?
  titleNative     String?
  imageUrl        String?
  format          String?
  episodes        Int?
  status          String?
  aniListUrl      String?
  isAdult         Boolean     @default(false)
  isDonghua       Boolean     @default(false)
  manualTitle     String?
  manualImageUrl  String?
  manualIsAdult   Boolean?
  manualIsDonghua Boolean?
  manualVisible   Boolean?
  duplicateGroupId Int?
  sourceUpdatedAt DateTime?
  deletedAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  season          AnimeSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  themes          AnimeTierListTheme[]

  @@unique([seasonId, aniListId])
  @@index([seasonId])
  @@index([deletedAt])
  @@index([duplicateGroupId])
}

model AnimeTierListTheme {
  id              Int                @id @default(autoincrement())
  tierListEntryId Int
  animeThemeId    Int?
  isManual        Boolean            @default(false)
  type            String
  sequence        Int
  songTitle       String?
  artist          String?
  videoUrl        String?
  videoResolution Int?
  videoSource     String?
  isNsfw          Boolean            @default(false)
  manualType      String?
  manualSequence  Int?
  manualVideoUrl  String?
  manualSongTitle String?
  manualArtist    String?
  manualVisible   Boolean?
  manualPrimarySourceLabel String?
  alternateVideoUrls Json?
  sourceUpdatedAt DateTime?
  deletedAt       DateTime?
  removedAt       DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  entry           AnimeTierListEntry @relation(fields: [tierListEntryId], references: [id], onDelete: Cascade)

  @@unique([tierListEntryId, animeThemeId])
  @@index([tierListEntryId])
  @@index([type])
  @@index([removedAt])
  @@index([deletedAt])
}

model PlatformUserAnimeTierList {
  id         Int      @id @default(autoincrement())
  userId     Int
  seasonId   Int
  kind       String
  isPublic   Boolean  @default(false)
  shareToken String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  season     AnimeSeason  @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  tiers      PlatformUserAnimeTier[]
  placements PlatformUserAnimeTierPlacement[]

  @@unique([userId, seasonId, kind])
  @@index([seasonId])
  @@index([shareToken])
}

model PlatformUserAnimeTier {
  id         Int      @id @default(autoincrement())
  tierListId Int
  label      String
  color      String
  position   Int

  tierList   PlatformUserAnimeTierList @relation(fields: [tierListId], references: [id], onDelete: Cascade)
  placements PlatformUserAnimeTierPlacement[]

  @@index([tierListId])
}

model PlatformUserAnimeTierPlacement {
  id         Int    @id @default(autoincrement())
  tierListId Int
  tierId     Int?
  itemId     Int
  position   Int

  tierList   PlatformUserAnimeTierList @relation(fields: [tierListId], references: [id], onDelete: Cascade)
  tier       PlatformUserAnimeTier?    @relation(fields: [tierId], references: [id], onDelete: SetNull)

  @@unique([tierListId, itemId])
  @@index([tierListId])
  @@index([tierId])
}

model AuditLog {
  id             Int      @id @default(autoincrement())
  createdAt      DateTime @default(now())
  actorUserId    Int?
  actorUsername  String?
  actorAlias     String?
  action         String
  module         String
  entityType     String
  entityId       String?
  entityLabel    String?
  summary        String?
  before         Json?
  after          Json?
  metadata       Json?
  ipAddress      String?
  userAgent      String?

  @@index([createdAt])
  @@index([module])
  @@index([entityType])
  @@index([entityId])
  @@index([actorUserId])
  @@index([action])
}
